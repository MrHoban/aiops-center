generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum UserRole {
  ADMINISTRATOR
  ENGINEER
  TECHNICIAN
  READ_ONLY
}

enum AssetType {
  SERVER
  WORKSTATION
  NETWORK_DEVICE
  CLOUD_RESOURCE
  APPLICATION
  VIRTUAL_MACHINE
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
}

enum AlertSeverity {
  INFORMATIONAL
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  SUPPRESSED
  RESOLVED
  ESCALATED
}

enum AlertSource {
  API
  SCHEDULED
  MANUAL
}

enum AutomationLanguage {
  POWERSHELL
  BASH
  PYTHON
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  FAILED
  CANCELLED
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATED
  RESOLVED
  CLOSED
}

enum CloudProvider {
  AZURE
  AWS
  GCP
}

enum ReportType {
  ASSET
  COMPLIANCE
  ALERT
  EXECUTIVE
}

enum ReportFormat {
  PDF
  CSV
  EXCEL
}

enum KnowledgeCategory {
  RUNBOOK
  SOP
  DOCUMENTATION
  TROUBLESHOOTING
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  assets             Asset[]
  alerts             Alert[]
  incidents          Incident[]
  automations        Automation[]
  knowledgeArticles  KnowledgeArticle[]
  cloudResources     CloudResource[]
  reports            Report[]
  auditLogs          AuditLog[]
  aiConversations    AIConversation[]
  escalationPolicies EscalationPolicy[]
  dashboardLayouts   DashboardLayout[]

  @@map("organizations")
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String    @unique
  name           String?
  passwordHash   String?
  role           UserRole  @default(TECHNICIAN)
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  image          String?
  emailVerified  DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accounts            Account[]
  sessions            Session[]
  ownedAssets         Asset[]              @relation("AssetOwner")
  acknowledgedAlerts  Alert[]              @relation("AlertAcknowledger")
  createdAlerts       Alert[]              @relation("AlertCreator")
  createdAutomations  Automation[]         @relation("AutomationCreator")
  approvedRuns        AutomationRun[]      @relation("RunApprover")
  executedRuns        AutomationRun[]      @relation("RunExecutor")
  knowledgeArticles   KnowledgeArticle[]   @relation("ArticleAuthor")
  reports             Report[]
  auditLogs           AuditLog[]
  aiConversations     AIConversation[]
  assignedIncidents   Incident[]           @relation("IncidentAssignee")
  dashboardLayouts    DashboardLayout[]

  @@index([organizationId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Asset {
  id              String      @id @default(cuid())
  organizationId  String
  name            String
  type            AssetType
  status          AssetStatus @default(ACTIVE)
  serialNumber    String?
  ipAddress       String?
  hostname        String?
  operatingSystem String?
  ownerId         String?
  warrantyExpiry  DateTime?
  documentationUrl String?
  metadata        Json        @default("{}")
  healthScore     Int         @default(100)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  alerts       Alert[]
  incidents    Incident[]

  @@index([organizationId, type])
  @@index([organizationId, status])
  @@map("assets")
}

model EscalationPolicy {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  steps          Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alerts       Alert[]

  @@index([organizationId])
  @@map("escalation_policies")
}

model Alert {
  id                 String        @id @default(cuid())
  organizationId     String
  title              String
  description        String        @db.Text
  severity           AlertSeverity
  status             AlertStatus   @default(OPEN)
  source             AlertSource
  assetId            String?
  correlationId      String?
  escalationPolicyId String?
  acknowledgedById   String?
  acknowledgedAt     DateTime?
  suppressedUntil    DateTime?
  resolvedAt         DateTime?
  metadata           Json          @default("{}")
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset            Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  escalationPolicy EscalationPolicy? @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)
  acknowledgedBy   User?             @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("AlertCreator", fields: [createdById], references: [id], onDelete: SetNull)
  incidents        Incident[]
  history          AlertHistory[]

  @@index([organizationId, status, severity])
  @@index([correlationId])
  @@map("alerts")
}

model AlertHistory {
  id        String   @id @default(cuid())
  alertId   String
  action    String
  details   Json     @default("{}")
  actorId   String?
  createdAt DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@map("alert_history")
}

model Incident {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  description    String         @db.Text
  status         IncidentStatus @default(OPEN)
  alertId        String?
  assetId        String?
  assigneeId     String?
  resolvedAt     DateTime?
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alert        Alert?       @relation(fields: [alertId], references: [id], onDelete: SetNull)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("incidents")
}

model Automation {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  description    String?
  language       AutomationLanguage
  script         String             @db.Text
  version        Int                @default(1)
  parameters     Json               @default("[]")
  schedule       String?
  requiresApproval Boolean          @default(false)
  isActive       Boolean            @default(true)
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User            @relation("AutomationCreator", fields: [createdById], references: [id])
  runs         AutomationRun[]
  versions     AutomationVersion[]

  @@index([organizationId])
  @@map("automations")
}

model AutomationVersion {
  id           String             @id @default(cuid())
  automationId String
  version      Int
  script       String             @db.Text
  parameters   Json               @default("[]")
  changelog    String?
  createdAt    DateTime           @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, version])
  @@map("automation_versions")
}

model AutomationRun {
  id           String              @id @default(cuid())
  automationId String
  status       AutomationRunStatus @default(PENDING)
  parameters   Json                @default("{}")
  output       String?             @db.Text
  error        String?             @db.Text
  executedById String?
  approvedById String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  executedBy User?      @relation("RunExecutor", fields: [executedById], references: [id], onDelete: SetNull)
  approvedBy User?      @relation("RunApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([automationId, status])
  @@map("automation_runs")
}

model KnowledgeArticle {
  id             String            @id @default(cuid())
  organizationId String
  title          String
  content        String            @db.Text
  category       KnowledgeCategory
  tags           String[]
  authorId       String
  isPublished    Boolean           @default(true)
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("ArticleAuthor", fields: [authorId], references: [id])

  @@index([organizationId, category])
  @@map("knowledge_articles")
}

model CloudResource {
  id             String        @id @default(cuid())
  organizationId String
  provider       CloudProvider
  resourceId     String
  name           String
  resourceType   String
  region         String?
  status         String        @default("unknown")
  monthlyCost    Decimal?      @db.Decimal(12, 2)
  securityFindings Json        @default("[]")
  metadata       Json          @default("{}")
  lastSyncedAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, resourceId])
  @@index([organizationId, provider])
  @@map("cloud_resources")
}

model Report {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           ReportType
  format         ReportFormat
  parameters     Json         @default("{}")
  fileUrl        String?
  generatedById  String
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedBy  User         @relation(fields: [generatedById], references: [id])

  @@index([organizationId, type])
  @@map("reports")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  details        Json     @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model AIConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String   @default("New conversation")
  context        Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AIMessage[]

  @@index([organizationId, userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String        @db.Text
  citations      Json          @default("[]")
  tokenCount     Int?
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model DashboardLayout {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  name           String   @default("Default")
  layout         Json
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("dashboard_layouts")
}
